---
import EventPage from '../../components/EventPage.astro';
import { eventDate, eventStart, eventTitle, eventVenue, getEvents } from '../../lib/events';

const upcoming = await getEvents('upcoming');
const past = await getEvents('past');
const eventsUrl = 'https://www.eventbrite.com.mx/o/mexai-comunidad-de-ia-106303535081';
---

<EventPage title="Encuentros">
	<p class="eyebrow"><span></span> Agenda de la comunidad</p>
	<h1>Encuentros</h1>
	<p class="event-intro">Nos reunimos cada mes para compartir lo que estamos construyendo con inteligencia artificial desde México. Aquí encuentras los próximos encuentros y el archivo de los anteriores.</p>

	<section class="event-section">
		<h2>Próximos encuentros</h2>
		{upcoming.length ? (
			<ul class="event-list">
				{upcoming.map((event) => (
					<li>
						{event.data.hero && (
							<img class="event-thumbnail" src={event.data.hero.src} alt={event.data.hero.alt} loading="lazy" decoding="async" />
						)}
						<div>
							<time class="card-kicker" datetime={eventStart(event)}>{eventDate(event)}</time>
							<h3>{eventTitle(event)}</h3>
							{eventVenue(event) && <p>{eventVenue(event)}</p>}
							{event.data.summary && <p>{event.data.summary}</p>}
							<a class="button button-dark" href={event.data.eventbrite?.url ?? eventsUrl} target="_blank" rel="noreferrer">Inscribirme en Eventbrite <span aria-hidden="true">↗</span></a>
						</div>
					</li>
				))}
			</ul>
		) : (
			<p class="event-empty">Por ahora no hay encuentros programados. <a class="text-link" href={eventsUrl} target="_blank" rel="noreferrer">Sigue a la comunidad en Eventbrite <span aria-hidden="true">↗</span></a></p>
		)}
	</section>

	<section class="event-section">
		<h2>Encuentros anteriores</h2>
		{past.length ? (
			<ul class="event-list">
				{past.map((event) => (
					<li>
						{event.data.hero && (
							<img class="event-thumbnail" src={event.data.hero.src} alt={event.data.hero.alt} loading="lazy" decoding="async" />
						)}
						<div>
							<time class="card-kicker" datetime={eventStart(event)}>{eventDate(event, false)}</time>
							<h3><a href={'/encuentros/' + event.id + '/'}>{eventTitle(event)}</a></h3>
							{eventVenue(event) && <p>{eventVenue(event)}</p>}
							{event.data.summary && <p>{event.data.summary}</p>}
						</div>
					</li>
				))}
			</ul>
		) : <p>Aún no hay encuentros en el archivo.</p>}
	</section>
</EventPage>

<style>
	.event-intro { max-width: 620px; color: var(--muted); font-size: 17px; line-height: 1.55; }
	.event-section { margin-top: 70px; }
	.event-section h2 { margin: 0; font-size: clamp(30px, 4vw, 44px); line-height: 1; letter-spacing: -1.5px; }
	.event-list { list-style: none; padding: 0; margin: 28px 0 0; }
	.event-list li {
		display: flex;
		gap: 24px;
		align-items: start;
		border-top: 1px solid rgb(16 44 59 / 22%);
		padding-block: 24px;
	}
	.event-thumbnail {
		width: clamp(100px, 23vw, 185px);
		flex: none;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}
	.event-list h3 { margin: 8px 0; font-size: clamp(22px, 3vw, 32px); line-height: 1.1; }
	.event-list h3 a:hover { text-decoration: underline; }
	.event-list p { margin: 4px 0; color: var(--muted); }
	.event-list .button { margin-top: 12px; }
	.event-empty { max-width: 620px; margin-top: 24px; color: var(--muted); }
	@media (max-width: 520px) { .event-list li { gap: 14px; } }
</style>
