---
import '../styles/global.css';
import MobileMenu from '../components/MobileMenu';

const eventsUrl = 'https://www.eventbrite.com.mx/o/mexai-comunidad-de-ia-106303535081';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="icon" href="/favicon.svg" />
		<title>Gracias | MexAI Community</title>
	</head>
	<body>
        <header class="site-header">
			<a class="brand" href="#inicio" aria-label="MexAI Community, inicio"><img class="brand-logo" src="/mexai_logo.png" alt="MexAI Community" /><span><strong>Comunidad de IA</strong><small>De México</small></span></a>
			<nav class="desktop-nav" aria-label="Navegación principal"><a href="#comunidad">La comunidad</a><a href="#aliados">Aliados</a><a href="#agenda">Agenda</a><a href="#propon-charla">Propón tu charla</a><a href="#colabora">Colabora</a></nav>
			<a class="header-link" href={eventsUrl} target="_blank" rel="noreferrer">Ver próximos eventos <span aria-hidden="true">↗</span></a>
			<MobileMenu eventsUrl={eventsUrl} client:load />
		</header>
		<main class="section-wrap thanks-page">
			<p class="eyebrow"><span></span> Propuesta recibida</p>
			<h1>¡Gracias por<br /><em>proponer tu charla!</em></h1>
			<p class="hero-intro">Revisaremos tu propuesta y te contactaremos por correo para coordinar los detalles.</p>
			<a class="button button-primary" href="/#inicio">Volver al inicio</a>
		</main>
	</body>
</html>
