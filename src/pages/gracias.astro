---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>Gracias | Comunidad de IA de México</title>
	</head>
	<body>
		<SiteHeader />
		<main class="section-wrap thanks-page">
			<p class="eyebrow"><span></span> Propuesta recibida</p>
			<h1>¡Gracias por<br /><em>proponer tu charla!</em></h1>
			<p class="hero-intro">Revisaremos tu propuesta y te contactaremos por correo para coordinar los detalles.</p>
			<a class="button button-primary" href="/#inicio">Volver al inicio</a>
		</main>
	</body>
</html>
